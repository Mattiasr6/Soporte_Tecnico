[Unit]
Description=Soporte Tecnico v2 DEV - API (FastAPI)
After=network.target

[Service]
Type=simple
User=mattias
WorkingDirectory=/home/mattias/Proyectos/Soporte_Tecnico2/backend-fastapi
ExecStart=/bin/bash -c 'set -a; source .env; set +a; exec .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 5012'
Restart=always
RestartSec=3
StandardOutput=append:/home/mattias/Proyectos/Soporte_Tecnico2/logs/api-dev.log
StandardError=append:/home/mattias/Proyectos/Soporte_Tecnico2/logs/api-dev.log

[Install]
WantedBy=multi-user.target
