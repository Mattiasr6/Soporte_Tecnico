[Unit]
Description=Soporte Tecnico v2 - API (FastAPI)
After=network.target

[Service]
Type=simple
User=mattias
WorkingDirectory=/home/mattias/Proyectos/Soporte_Tecnico-python/backend-fastapi
ExecStart=/bin/bash -c 'set -a; source .env; set +a; exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5002'
Restart=always
RestartSec=3
StandardOutput=append:/home/mattias/Proyectos/Soporte_Tecnico-python/logs/api.log
StandardError=append:/home/mattias/Proyectos/Soporte_Tecnico-python/logs/api.log

[Install]
WantedBy=multi-user.target
