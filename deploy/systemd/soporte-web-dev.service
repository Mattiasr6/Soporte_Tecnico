[Unit]
Description=Soporte Tecnico v2 DEV - Web (Django)
After=network.target soporte-api-dev.service
Wants=soporte-api-dev.service

[Service]
Type=simple
User=mattias
WorkingDirectory=/home/mattias/Proyectos/Soporte_Tecnico2/frontend-django
ExecStart=/bin/bash -c 'set -a; source .env; set +a; exec .venv/bin/python manage.py runserver 0.0.0.0:8011'
Restart=always
RestartSec=3
StandardOutput=append:/home/mattias/Proyectos/Soporte_Tecnico2/logs/web-dev.log
StandardError=append:/home/mattias/Proyectos/Soporte_Tecnico2/logs/web-dev.log

[Install]
WantedBy=multi-user.target
