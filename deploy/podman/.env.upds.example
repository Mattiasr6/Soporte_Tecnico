# UPDS isolated dev stack (upds.compose.yml). Copy to .env.upds and replace every value.
# Usage, from deploy/podman:
#   podman-compose --env-file .env.upds -f upds.compose.yml up -d --build
# Ports: API 127.0.0.1:5013 · Django 8013 · Postgres 127.0.0.1:5435 · Angular 4213

# Postgres (db service; the api builds DATABASE_URL from these)
POSTGRES_USER=soporte
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soporte_upds

# FastAPI (api service)
JWT_SECRET=change-me-to-a-long-random-string
# Asignación photos; defaults to backend-fastapi/data when empty
ASIGNACION_DATA_DIR=

# Django (web service, legacy frontend still running during the migration)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1

# Optional: password for the seed_*.py scripts
SEED_PASSWORD=change-me

# Optional: IA services (not used by the Angular frontend)
# LLAMA_URL=
# LLAMA_API_KEY=
# CHROMA_DIR=
